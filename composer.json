{
    "name": "super-kernel/composer-resolver",
    "description": "The composer-resolver component for super-kernel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "super-kernel",
        "composer",
        "resolver",
        "composer-resolver"
    ],
    "homepage": "https://github.com/super-kernel/composer-resolver",
    "support": {
        "issues": "https://github.com/super-kernel/composer-resolver/issues",
        "source": "https://github.com/super-kernel/composer-resolver"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\ComposerResolver\\": "src/"
        }
    },
    "config": {
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "~8.4.0",
        "super-kernel/attribute": "dev-main",
        "super-kernel/contract": "dev-main",
        "super-kernel/process-handler": "dev-main",
        "super-kernel/tokenizer": "dev-main"
    },
    "require-dev": {
        "super-kernel/path-resolver": "dev-main",
        "super-kernel/reflector": "dev-main",
        "symfony/console": "~8.0.0"
    }
}
